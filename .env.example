# ============================================================================
# Application Configuration
# ============================================================================
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
WEB_PORT=8000
VITE_PORT=5173
VITE_HOST=localhost
DB_FORWARD_PORT=3306
PHPMYADMIN_PORT=8080
REDIS_FORWARD_PORT=6379
APP_URL=http://localhost:${WEB_PORT}
FRONTEND_URL=http://localhost:3000
APP_TIMEZONE=UTC
GOOGLE_CLIENT_ID=336599020681-fpefm205darlpb25si31nfpfqfedv6fg.apps.googleusercontent.com

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_ENABLE_QUERY_LOG=false
LOG_SLOW_QUERY_THRESHOLD=1000

# ============================================================================
# Database Configuration
# ============================================================================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel_db
DB_USERNAME=laravel_user
DB_PASSWORD=root

# ============================================================================
# Cache Configuration
# ============================================================================
CACHE_DRIVER=file
CACHE_PREFIX=laravel_cache

# For Redis cache (production)
# CACHE_DRIVER=redis
# CACHE_PREFIX=laravel_cache

# ============================================================================
# Session Configuration
# ============================================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# For Redis sessions (production)
# SESSION_DRIVER=redis

# ============================================================================
# Queue Configuration
# ============================================================================
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=database-uuids

# For Redis queue (production)
# QUEUE_CONNECTION=redis
# REDIS_HOST=redis
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# REDIS_DB=0

# For database queue
# QUEUE_CONNECTION=database

# ============================================================================
# Mail Configuration
# ============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_LOG_CHANNEL=
MAIL_EHLO_DOMAIN=
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -t -i"
MAIL_FAILOVER_MAILERS=smtp,log

# Postmark
POSTMARK_TOKEN=

# Mailgun
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# For production (Gmail example)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_ENCRYPTION=tls

# For SendGrid
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key
# MAIL_ENCRYPTION=tls

# For Mailgun
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=your-domain.com
# MAILGUN_SECRET=your-mailgun-secret
# MAILGUN_ENDPOINT=api.mailgun.net

# ============================================================================
# AWS Configuration (Optional)
# ============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================================================
# Redis Configuration (Optional)
# ============================================================================
# Docker: use REDIS_HOST=redis (service name in docker-compose)
# Local:  use REDIS_HOST=127.0.0.1
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ============================================================================
# Broadcasting Configuration (Optional)
# ============================================================================
BROADCAST_DRIVER=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# ============================================================================
# File System Configuration
# ============================================================================
FILESYSTEM_DISK=local
FILE_DEFAULT_DISK=private
FILE_MAX_SIZE_KB=10240
FILE_MAX_FILE_COUNT=10
FILE_ALLOWED_MIMES=jpg,jpeg,png,gif,webp,pdf,doc,docx,xls,xlsx,csv,txt,zip

# For S3 (Public)
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=your-bucket-name
# AWS_BUCKET_PRIVATE=your-private-bucket-name  # Optional, defaults to AWS_BUCKET
# AWS_URL=https://your-bucket.s3.amazonaws.com  # Optional
# AWS_ENDPOINT=  # Optional, for S3-compatible services
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================================================
# Sanctum Configuration
# ============================================================================
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,::1
SESSION_DOMAIN=null

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ============================================================================
# Swagger Configuration
# ============================================================================
L5_SWAGGER_USE_ABSOLUTE_PATH=false
L5_FORMAT_TO_USE_FOR_DOCS=json
SWAGGER_VERSION=3.0
L5_SWAGGER_CONST_HOST=http://localhost:8000

# ============================================================================
# API Rate Limiting Configuration
# ============================================================================
# Rate limits for API endpoints (requests per minute)
API_RATE_LIMIT_AUTHENTICATED=100  # For authenticated users
API_RATE_LIMIT_GUEST=60           # For unauthenticated users (guests)

# ============================================================================
# Security Headers
# ============================================================================
SECURITY_HEADERS_ENABLED=true
# SECURITY_CSP=default-src 'self';
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false
SECURITY_X_FRAME_OPTIONS=SAMEORIGIN
SECURITY_X_CONTENT_TYPE_OPTIONS=nosniff
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
# SECURITY_PERMISSIONS_POLICY=geolocation=(), microphone=()

# ============================================================================
# Environment-Specific Configurations
# ============================================================================

# Local Development
# APP_ENV=local
# APP_DEBUG=true
# LOG_LEVEL=debug
# CACHE_DRIVER=file
# QUEUE_CONNECTION=sync

# Staging
# APP_ENV=staging
# APP_DEBUG=false
# LOG_LEVEL=info
# CACHE_DRIVER=redis
# QUEUE_CONNECTION=redis

# Production
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=error
# CACHE_DRIVER=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis
